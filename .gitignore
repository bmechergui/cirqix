.env.test.local
.env.production.local
.env*.local

# Local shell aliases (contiennent des clés API — jamais commités)
*.local.ps1

# MCP project config (contains access tokens — never commit)
.mcp.json

# Local Codex MCP config (contains personal access tokens — never commit)
.codex/config.toml

# Local agent runtime files (machine-specific — never commit)
.agents/
.codex/hooks.json
.claude/settings.local.json

# Graphify knowledge graph (artefact régénérable — graphify update .)
graphify-out/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db


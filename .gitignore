# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
venv
.venv
*.egg-info
dist/

# Docker
.docker/

# Misc
*.tsbuildinfo
next-env.d.ts

# Debug screenshots
*.png
*.jpg.bak
# …sauf le rendu de référence des cas d'étude : CLAUDE.md impose que
# examples/<cas>/expected/ contienne 1 board final + 1 rendu. Sans cette
# exception il faut un `git add -f` à chaque fois (c'est ainsi que le rendu de
# stm32-validation a été committé) — donc une convention qui ne tient pas seule.
!services/kicad/examples/*/expected/*.png

# Playwright MCP cache
.playwright-mcp/

# Modèles 3D téléchargés (STEP/WRL zippés par footprint)
# 3,1 Go pour 101 archives au 2026-08-09 — cache local, re-téléchargeable.
# Sans cette ligne, un `git add -A` distrait fait entrer 3 Go dans l'historique,
# irréversible sans réécriture.
services/kicad/models/

# Configuration locale des autres assistants. CLAUDE.md est la source canonique ;
# ces répertoires ne contiennent que des adaptateurs propres à une machine.
.cursor/
.gemini/

# Test KiCad static files
apps/web/public/test-*.kicad_sch
apps/web/public/test-*.kicad_pcb
apps/web/public/test-*.html
apps/web/public/test-kicad.html

# Temp dev artifacts
tmp/

# Validation test output (generated by validate-schema-placement.test.ts)
validation-output/

# Stray KiCad test-output dirs — absolute test paths accidentally created at repo root
*Kicadmcptest*/
.history/
services/kicad/examples/*/output/

# KiCad GUI lock files (created when a board is opened in the GUI)
*.lck

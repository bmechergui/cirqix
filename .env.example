# ============================================================
# Cirqix — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ============================================================

# Anthropic (agents Claude)
ANTHROPIC_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Redis (Upstash ou Railway)
REDIS_URL=
# Upstash REST (rate limiting PLAN §5.1 — sans ces variables, le limiter est
# désactivé en fail-open ; les poser en prod active la protection)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Lemon Squeezy (paiement)
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
# IDs variant des packs de top-up (crédités par /api/webhooks/lemon-squeezy)
LS_VARIANT_TOPUP_20=
LS_VARIANT_TOPUP_100=
LS_VARIANT_TOPUP_300=
# IDs produit des abonnements (Pro 25€ → 100 cr/mois, Pro Max 50€ → 300 cr/mois)
LS_PRODUCT_PRO=
LS_PRODUCT_PRO_MAX=
# URLs de checkout Lemon Squeezy (page /dashboard/billing) — le user_id est
# ajouté en custom_data par la page, ne pas l'inclure ici
NEXT_PUBLIC_LS_CHECKOUT_TOPUP_20=
NEXT_PUBLIC_LS_CHECKOUT_TOPUP_100=
NEXT_PUBLIC_LS_CHECKOUT_TOPUP_300=
NEXT_PUBLIC_LS_CHECKOUT_PRO=
NEXT_PUBLIC_LS_CHECKOUT_PRO_MAX=

# Service KiCad (Docker, Railway ou DigitalOcean)
KICAD_SERVICE_URL=http://localhost:8766
# Secret partagé serveur-à-serveur (générer une valeur aléatoire longue).
KICAD_SERVICE_TOKEN=

# Email (Resend)
RESEND_API_KEY=

# SnapMagic (footprints)
SNAPMAGIC_API_KEY=

# OpenAI (embeddings pgvector — optionnel, améliore la recherche footprint)
OPENAI_API_KEY=

# Octopart (composants)
OCTOPART_API_KEY=

# URL publiques apps
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3002
